docs {
  # auth:requestDemoOtp (MUTATION)
  
  Validasi email ITS (10 digit NRP) & minta kode OTP demo
  
  Memvalidasi format `/^\d{10}@student\.its\.ac\.id$/`, memeriksa ketersediaan akun untuk mode `login` atau `signup`, dan mengembalikan kode OTP demo `123456`.
  
  ## Parameter (`args`)
  - `email` (string, Wajib): Email mahasiswa ITS (10 digit NRP@student.its.ac.id)
  - `mode` ("login" | "signup", Wajib): Mode autentikasi (login atau signup)
  - `name` (string, Opsional): Nama lengkap mahasiswa (wajib saat mode = signup)
  
  ## Pemanggilan di React (Convex Hook)
  ```ts
  const requestOtp = useMutation(api.auth.requestDemoOtp);
  await requestOtp({ email: "0000000001@student.its.ac.id", mode: "login" });
  ```
}
