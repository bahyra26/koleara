meta {
  name: [QUERY] chat.listMessages
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/convex/chat/listMessages
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "conversationId": "conv-demo-seed-1"
  }
}

docs {
  # chat:listMessages (QUERY)
  
  Ambil seluruh bubble pesan dalam 1 ruang chat secara real-time
  
  Mengambil pesan teks (`type: 'text'`) maupun kartu tawaran sesi (`type: 'offer'`) terurut secara kronologis.
  
  ## Parameter (`args`)
  - `conversationId` (string, Wajib): ID percakapan (contoh: conv-demo-seed-1)
  
  ## Pemanggilan di React (Convex Hook)
  ```ts
  const messages = useQuery(api.chat.listMessages, { conversationId: "conv-demo-seed-1" });
  ```
}
